<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/local.damon-mobile.plist, replace every __PLACEHOLDER__,
     then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.damon-mobile.plist -->
<plist version="1.0">
<dict>
	<key>Label</key><string>local.damon-mobile</string>
	<key>ProgramArguments</key>
	<array><string>__BUN_PATH__</string><string>run</string><string>__REPO_PATH__/server.ts</string></array>
	<key>WorkingDirectory</key><string>__REPO_PATH__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>DAMON_MOBILE_TS_IP</key><string>__THIS_MACS_TAILSCALE_IP__</string>
		<key>DAMON_MOBILE_LOGIN</key><string>__YOUR_TAILSCALE_LOGIN__</string>
	</dict>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ThrottleInterval</key><integer>10</integer>
	<key>StandardOutPath</key><string>__REPO_PATH__/logs/server.log</string>
	<key>StandardErrorPath</key><string>__REPO_PATH__/logs/server.log</string>
</dict>
</plist>
